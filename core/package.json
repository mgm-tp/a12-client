{
  "name": "@com.mgmtp.a12.client/client-core",
  "version": "17.1.0",
  "description": "Client Core Library",
  "author": "mgm technology partners",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "scripts": {
    "clean": "rimraf ./lib ./target cyclonedx.json",
    "build": "node --run compile && node --run typedoc && pnpm \"/^validate:.+/\"",
    "test": "mocha",
    "test:coverage": "c8 mocha",
    "compile": "tsc",
    "typedoc": "typedoc",
    "typescript": "tsc --project ./tsconfig.dev.json",
    "watch": "tsc --project ./tsconfig.dev.json --watch",
    "validate:cycles": "depcruise --config scripts/dependency-cruiser-errors-only.js --output-type err-long src",
    "validate:tsc": "devtools verify-ts-compat ./tsconfig.lib.json -p",
    "validate:api": "api-extractor run --verbose",
    "update:api": "api-extractor run --local",
    "mocha": "mocha",
    "mocha:dev": "mocha --forbid-only=false --reporter=spec",
    "cycles": "depcruise --config scripts/dependency-cruiser.js --output-type err-long src",
    "cycles:dot": "depcruise --config scripts/dependency-cruiser-graph.js --output-type flat src | sed '/\"\\([^\"]*\\)\" -> \"\\1\"/d'",
    "cycles:svg": "node --run cycles:dot | dot -T svg > dependencygraph.svg",
    "cycles:html": "node --run cycles:dot | dot -T svg | depcruise-wrap-stream-in-html > dependencygraph.html",
    "analyze-scripting-dependencies": "devtools analyze-dependencies \"./src/extensions/scripting*/**/*.@(ts|tsx)\" \"src\\/extensions\\/(scripting[^\\/]*\\/[^\\/]+)\\/.*\"",
    "lint": "pnpm -w exec oxlint core",
    "lint:fix": "pnpm -w exec oxlint --fix core",
    "lint:onlyErrors": "pnpm -w exec oxlint --quiet core"
  },
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "@com.mgmtp.a12.client/typescript-fsa-redux-5-compat": "catalog:a12",
    "fast-deep-equal": "catalog:",
    "fp-ts": "catalog:",
    "monocle-ts": "catalog:",
    "semver": "catalog:"
  },
  "devDependencies": {
    "@com.mgmtp.a12.base/base-model-api": "catalog:a12",
