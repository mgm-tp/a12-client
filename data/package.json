{
  "name": "@com.mgmtp.a12.client/client-data",
  "version": "17.0.0",
  "description": "Experimental data access code",
  "author": "mgm technology partners",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "type": "module",
  "sideEffects": false,
  "exports": "./lib/index.js",
  "scripts": {
    "clean": "rimraf ./lib ./target cyclonedx.json",
    "build": "node --run compile && pnpm \"/^validate:.+/\"",
    "test": "mocha",
    "compile": "tsc",
    "validate:cycles": "devtools detect-cycles \"./src/**/*.@(ts|tsx)\"",
    "validate:tsc": "devtools verify-ts-compat ./tsconfig.lib.json -p",
    "validate:api": "api-extractor run --verbose",
    "update:api": "api-extractor run --local",
    "watch": "tsc --project ./tsconfig.dev.json --watch",
    "lint": "eslint --flag unstable_native_nodejs_ts_config . --cache",
    "lint:fix": "node --run lint -- --fix",
    "lint:onlyErrors": "node --run lint -- --quiet"
  },
  "dependencies": {
    "@com.mgmtp.a12.client/typescript-fsa-redux-5-compat": "catalog:a12",
    "lodash.merge": "catalog:"
  },
  "devDependencies": {
    "@com.mgmtp.a12.base/base-model-api": "catalog:a12",
    "@com.mgmtp.a12.client/client-core": "workspace:*",
    "@com.mgmtp.a12.dataservices/dataservices-access": "catalog:a12",
    "@com.mgmtp.a12.devtools/build-tools": "catalog:a12",
    "@com.mgmtp.a12.devtools/tsconfig": "catalog:a12",
    "@com.mgmtp.a12.kernel/kernel-core-runtime-api-ts": "catalog:a12",
    "@com.mgmtp.a12.kernel/kernel-md-facade": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-localization": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-logging": "catalog:a12",
    "@microsoft/api-extractor": "catalog:",
    "@types/lodash.merge": "catalog:",
    "@types/mocha": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-mocha": "catalog:",
    "mocha": "catalog:",
    "rimraf": "catalog:",
    "source-map-support": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@com.mgmtp.a12.base/base-model-api": "catalog:a12ranges",
    "@com.mgmtp.a12.client/client-core": "workspace:*",
    "@com.mgmtp.a12.dataservices/dataservices-access": "catalog:a12ranges",
    "@com.mgmtp.a12.kernel/kernel-core-runtime-api-ts": "catalog:a12ranges",
    "@com.mgmtp.a12.kernel/kernel-md-facade": "catalog:a12ranges",
    "@com.mgmtp.a12.utils/utils-localization": "catalog:a12ranges",
    "@com.mgmtp.a12.utils/utils-logging": "catalog:a12ranges"
  },
  "files": [
    "lib",
    "!lib/test",
    "src",
    "!src/test",
    "cyclonedx.json",
    "NOTICE",
    "THIRD_PARTY_NOTICES",
    "licenses"
  ]
}
