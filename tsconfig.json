{
	"include": [
		"oxfmt.config.ts",
		"oxlint.config.ts",
		"scripts/validateA12Peers.ts"
	],
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"erasableSyntaxOnly": true,
		"isolatedModules": true,
		"lib": ["ESNext"],
		"module": "NodeNext",
		"moduleDetection": "force",
		"noEmit": true,
		"resolveJsonModule": true,
		"strictNullChecks": true,
		"types": ["node"],
		"verbatimModuleSyntax": true
	}
}
