{
  "header": {
    "id": "errorBoundaries.appmodel",
    "modelType": "application",
    "modelVersion": "6.0.0",
    "locales": [
      {
        "code": "en"
      },
      {
        "code": "de"
      }
    ]
  },
  "content": {
    "region": {
      "name": "APP",
      "layout": {
        "name": "ApplicationFrame"
      },
      "subRegions": [
        {
          "name": "CONTENT",
          "layout": {
            "name": "MasterDetail"
          }
        }
      ]
    },
    "defaultRegion": [
      "CONTENT"
    ],
    "modules": [
      {
        "name": "error_handling.error-boundaries",
        "menu": {
          "name": "error_handling.error-boundaries",
          "label": [
            {
              "locale": "en",
              "text": "Error Boundaries"
            },
            {
              "locale": "de",
              "text": "Error Boundaries"
            }
          ],
          "initialActivity": {
            "descriptor": {
              "section": "ErrorHandling",
              "feature": "ErrorBoundaries"
            }
          }
        },
        "flows": [
          {
            "name": "error_handling.error-boundaries",
            "scenes": [
              {
                "name": "ErrorBoundaries",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "ErrorHandling"
                  },
                  {
                    "key": "feature",
                    "mustEqual": "ErrorBoundaries"
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "REGION_CLEAR"
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "ErrorBoundaries"
                    }
                  ]
                }
              },
              {
                "name": "EngineWithError",
                "description": "This scene is used as an example for error boundaries. It tries to render a UI engine, but throws a javascript error during its render method.",
                "priorScene": "ErrorBoundaries",
                "matchConditions": [
                  {
                    "key": "feature",
                    "mustEqual": "EngineWithError"
                  },
                  {
                    "key": "model",
                    "mustEqual": "Book-document"
                  },
                  {
                    "key": "instance",
                    "isSet": false
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "EngineWithError",
                      "models": [
                        {
                          "modelType": "document",
                          "name": "Book-document"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
