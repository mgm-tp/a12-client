              "feature": "ViewsConcept"
            }
          }
        },
        "flows": [
          {
            "name": "ui_handling.views-concept",
            "scenes": [
              {
                "name": "ViewsConcept",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "UIHandling"
                  },
                  {
                    "key": "feature",
