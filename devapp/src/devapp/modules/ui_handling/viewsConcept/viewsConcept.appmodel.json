    "defaultRegion": [
      "CONTENT"
    ],
    "modules": [
      {
        "name": "ui_handling.views-concept",
        "menu": {
          "name": "ui_handling.views-concept",
          "label": [
            {
              "locale": "en",
              "text": "Views Concept"
            },
            {
              "locale": "de",
              "text": "Views-Konzept"
            }
          ],
          "initialActivity": {
