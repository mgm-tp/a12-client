                      "type": "REGION_CLEAR"
                    },
                    {
                      "type": "REGION_CLEAR",
                      "region": [
                        "SIDEBAR"
                      ]
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "ViewsConceptEmpty",
                      "constraints": {
                        "type": "MasterDetail"
                      }
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "ViewsConcept",
                      "constraints": {
                        "type": "MasterDetail"
                      }
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "SampleSidebarContent",
                      "region": [
                        "SIDEBAR"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
