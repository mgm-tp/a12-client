{
  "header": {
    "id": "dashboard-layout.appmodel",
    "modelType": "application",
    "modelVersion": "6.0.0",
    "locales": [
      {
        "code": "en"
      },
      {
        "code": "de"
      }
    ]
  },
  "content": {
    "region": {
      "name": "APP",
      "layout": {
        "name": "ApplicationFrame"
      },
      "subRegions": [
        {
          "name": "CONTENT",
          "layout": {
            "name": "MasterDetail"
          }
        },
        {
          "name": "SIDEBAR",
          "layout": {
            "name": "Null"
          }
        }
      ]
    },
    "defaultRegion": [
      "CONTENT"
    ],
    "modules": [
      {
        "name": "ui_handling.dashboard-layout",
        "menu": {
          "name": "ui_handling.dashboard-layout",
          "label": [
            {
              "locale": "en",
              "text": "Dashboard Layout"
            },
            {
              "locale": "de",
              "text": "Dashboard Layout"
            }
          ],
          "children": [
            {
              "name": "single-activity",
              "label": [
                {
                  "locale": "en",
                  "text": "Single Activity"
                },
                {
                  "locale": "de",
                  "text": "Einzelne Activity"
                }
              ],
              "initialActivity": {
                "descriptor": {
                  "section": "UIHandling",
                  "feature": "DashboardSingleActivity"
                }
              }
            },
            {
              "name": "multiple-activities",
              "label": [
                {
                  "locale": "en",
                  "text": "Multiple Activities"
                },
                {
                  "locale": "de",
                  "text": "Mehrere Activitys"
                }
              ],
              "initialActivity": {
                "descriptor": {
                  "section": "UIHandling",
                  "feature": "DashboardMultipleActivities"
                }
              }
            }
          ]
        },
        "flows": [
          {
            "name": "ui_handling.dashboard-layout",
            "scenes": [
              {
                "name": "DashboardSingleActivity",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "UIHandling"
                  },
                  {
                    "key": "feature",
                    "mustEqual": "DashboardSingleActivity"
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "REGION_CLEAR",
                      "region": [
                        "SIDEBAR"
                      ]
                    },
                    {
                      "type": "REGION_CLEAR",
                      "layout": {
                        "name": "Dashboard",
                        "settings": {
                          "rows": [
                            {
                              "columns": [
                                {
                                  "width": {
                                    "sm": 9,
                                    "md": 8,
                                    "lg": 9
                                  }
                                },
                                {
                                  "width": {
                                    "sm": 3,
                                    "md": 4,
                                    "lg": 3
                                  },
                                  "rows": [
                                    {
                                      "columns": [
                                        {
                                          "width": {
                                            "sm": 12,
                                            "md": 12,
                                            "lg": 12
                                          }
                                        }
                                      ]
                                    },
                                    {
                                      "columns": [
                                        {
                                          "width": {
                                            "sm": 12,
                                            "md": 12,
                                            "lg": 12
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "columns": [
                                {
                                  "width": {
                                    "sm": 12,
                                    "md": 4,
                                    "lg": 4
                                  }
                                },
                                {
                                  "width": {
                                    "sm": 12,
                                    "md": 8,
                                    "lg": 8
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      }
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "DashboardIntroTile"
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "DashboardCalendarTile"
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "DashboardNotesTile"
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "DashboardTasksTile"
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "DashboardMessagesTile"
                    }
                  ],
                  "onExit": [
                    {
                      "type": "REGION_CLEAR",
                      "layout": {
                        "name": "MasterDetail"
                      }
                    }
                  ]
                }
              },
              {
                "name": "DashboardMultipleActivities",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "UIHandling"
                  },
                  {
                    "key": "feature",
                    "mustEqual": "DashboardMultipleActivities"
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "REGION_CLEAR",
                      "region": [
                        "SIDEBAR"
                      ]
                    },
                    {
                      "type": "REGION_CLEAR",
                      "layout": {
                        "name": "Dashboard",
                        "settings": {
                          "rows": [
                            {
                              "columns": [
                                {
                                  "width": {
                                    "sm": 9,
                                    "md": 8,
                                    "lg": 8
                                  }
                                },
                                {
                                  "width": {
                                    "sm": 3,
                                    "md": 4,
                                    "lg": 4
                                  }
                                }
                              ]
                            },
                            {
                              "columns": [
                                {
                                  "width": {
                                    "sm": 6,
                                    "md": 6,
                                    "lg": 6
                                  }
                                },
                                {
                                  "width": {
                                    "sm": 6,
                                    "md": 6,
                                    "lg": 6
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              },
              {
                "name": "DashboardSceneIntroTile",
                "description": "This scene adds the intro tile",
                "priorScene": "DashboardMultipleActivities",
                "matchConditions": [
                  {
                    "key": "tile",
                    "mustEqual": "MultipleActivitiesDashboardIntroTile"
                  },
                  {
                    "key": "instance",
                    "isSet": false
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "MultipleActivitiesDashboardIntroTile"
                    }
                  ]
                }
              },
              {
                "name": "DashboardSceneArticleTile",
                "description": "This scene adds the article tile",
                "priorScene": "DashboardMultipleActivities",
                "matchConditions": [
                  {
                    "key": "tile",
                    "mustEqual": "DashboardArticleTile"
                  },
                  {
                    "key": "instance",
                    "isSet": false
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "DashboardArticleTile"
                    }
                  ]
                }
              },
              {
                "name": "DashboardSceneOverviewCrudTile",
                "description": "This scene adds the overview engine tile for the CRUD model",
                "priorScene": "DashboardMultipleActivities",
                "matchConditions": [
                  {
                    "key": "model",
                    "mustEqual": "Person-document"
                  },
                  {
                    "key": "instance",
                    "isSet": false
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "PersonOverview",
                      "models": [
                        {
                          "modelType": "document",
                          "name": "Person-document"
                        }
                      ]
                    }
                  ],
                  "onExit": [
                    {
                      "type": "REGION_CLEAR",
                      "layout": {
                        "name": "MasterDetail"
                      }
                    }
                  ]
                }
              },
              {
                "name": "DashboardSceneOverviewOfferTile",
                "description": "This scene adds the overview engine tile for the offer model",
                "priorScene": "DashboardMultipleActivities",
                "matchConditions": [
                  {
                    "key": "model",
                    "mustEqual": "Offer-document"
                  },
                  {
                    "key": "instance",
                    "isSet": false
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "OfferOverview",
                      "models": [
                        {
                          "modelType": "document",
                          "name": "Offer-document"
                        }
                      ]
                    }
                  ],
                  "onExit": [
                    {
                      "type": "REGION_CLEAR",
                      "layout": {
                        "name": "MasterDetail"
                      }
                    }
                  ]
                }
              },
              {
                "name": "DashboardSceneOverviewCrudDetail",
                "description": "This scene shows the form engine when a row from the CRUD overview engine tile is selected",
                "priorScene": "DashboardSceneOverviewCrudTile",
                "matchConditions": [
                  {
                    "key": "instance",
                    "isSet": true
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "PersonForm",
                      "models": [
                        {
                          "modelType": "document",
                          "name": "Person-document"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "name": "DashboardSceneOverviewOfferDetail",
                "description": "This scene shows the form engine when a row from the Offer overview engine tile is selected",
                "priorScene": "DashboardSceneOverviewOfferTile",
                "matchConditions": [
                  {
                    "key": "instance",
                    "isSet": true
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "OfferForm",
                      "models": [
                        {
                          "modelType": "document",
                          "name": "Offer-document"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
