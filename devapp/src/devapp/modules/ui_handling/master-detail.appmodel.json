{
  "header": {
    "id": "master-detail.appmodel",
    "modelType": "application",
    "modelVersion": "6.0.0",
    "locales": [
      {
        "code": "en"
      },
      {
        "code": "de"
      }
    ]
  },
  "content": {
    "region": {
      "name": "APP",
      "layout": {
        "name": "ApplicationFrame"
      },
      "subRegions": [
        {
          "name": "CONTENT",
          "layout": {
            "name": "MasterDetail"
          }
        }
      ]
    },
    "defaultRegion": [
      "CONTENT"
    ],
    "modules": [
      {
        "name": "ui_handling.master-detail",
        "menu": {
          "name": "ui_handling.master-detail",
          "label": [
            {
              "locale": "en",
              "text": "Master Detail Layout"
            },
            {
              "locale": "de",
              "text": "Master Detail Layout"
            }
          ],
          "initialActivity": {
            "descriptor": {
              "section": "UIHandling",
              "feature": "MasterDetailEntry"
            }
          }
        },
        "flows": [
          {
            "name": "ui_handling.master-detail",
            "scenes": [
              {
                "name": "MasterDetailEntry",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "UIHandling"
                  },
                  {
                    "key": "feature",
                    "mustEqual": "MasterDetailEntry"
                  },
                  {
                    "key": "instance",
                    "isSet": false
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "MasterDetailDescription",
                      "constraints": {
                        "type": "MasterDetail"
                      }
                    }
                  ]
                }
              },
              {
                "name": "MasterDetailNext1",
                "matchConditions": [
                  {
                    "key": "instance",
                    "isSet": true
                  }
                ],
                "priorScene": "MasterDetailEntry",
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "MasterDetailView",
                      "constraints": {
                        "type": "MasterDetail",
                        "preferredWidth": 8
                      }
                    }
                  ]
                }
              },
              {
                "name": "MasterDetailNext2",
                "matchConditions": [],
                "priorScene": "MasterDetailNext1",
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "MasterDetailView",
                      "constraints": {
                        "type": "MasterDetail",
                        "preferredWidth": 10
                      }
                    }
                  ],
                  "onExit": [
                    {
                      "type": "VIEW_ADD",
                      "name": "MasterDetailView",
                      "constraints": {
                        "type": "MasterDetail",
                        "preferredWidth": 10
                      }
                    }
                  ]
                }
              },
              {
                "name": "MasterDetailNext3",
                "matchConditions": [],
                "priorScene": "MasterDetailNext2",
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "MasterDetailView",
                      "constraints": {
                        "type": "MasterDetail",
                        "preferredWidth": 4
                      }
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
