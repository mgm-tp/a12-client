{
  "header": {
    "id": "case-concept.appmodel",
    "modelType": "application",
    "modelVersion": "6.0.0",
    "locales": [
      {
        "code": "en"
      },
      {
        "code": "de"
      }
    ]
  },
  "content": {
    "region": {
      "name": "APP",
      "layout": {
        "name": "ApplicationFrame"
      },
      "subRegions": [
        {
          "name": "CONTENT",
          "layout": {
            "name": "MasterDetail"
          }
        },
        {
          "name": "SIDEBAR",
          "layout": {
            "name": "Null"
          }
        }
      ]
    },
    "defaultRegion": [
      "CONTENT"
    ],
    "modules": [
      {
        "name": "ui_handling.case.concept",
        "menu": {
          "name": "ui_handling.case.concept",
          "label": [
            {
              "locale": "en",
              "text": "Concept"
            },
            {
              "locale": "de",
              "text": "Konzept"
            }
          ],
          "initialActivity": {
            "descriptor": {
              "section": "UIHandling",
              "feature": "CaseConcept"
            }
          }
        },
        "flows": [
          {
            "name": "ui_handling.case.concept",
            "scenes": [
              {
                "name": "CaseConcept",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "UIHandling"
                  },
                  {
                    "key": "feature",
                    "mustEqual": "CaseConcept"
                  }
                ],
                "defaultCase": "TableCase",
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "GenericCaseMenu",
                      "region": [
                        "SIDEBAR"
                      ]
                    }
                  ]
                },
                "cases": [
                  {
                    "name": "TableCase",
                    "label": [
                      {
                        "locale": "en",
                        "text": "Table View"
                      },
                      {
                        "locale": "de",
                        "text": "Tabellen-View"
                      }
                    ],
                    "sceneChange": {
                      "onEnter": [
                        {
                          "type": "VIEW_ADD",
                          "name": "CaseConcept.TableCase"
                        }
                      ]
                    }
                  },
                  {
                    "name": "ChartCase",
                    "label": [
                      {
                        "locale": "en",
                        "text": "Chart View"
                      },
                      {
                        "locale": "de",
                        "text": "Diagramm-View"
                      }
                    ],
                    "sceneChange": {
                      "onEnter": [
                        {
                          "type": "VIEW_ADD",
                          "name": "CaseConcept.ChartCase"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "ui_handling.case.model-loading",
        "menu": {
          "name": "ui_handling.case.model-loading",
          "label": [
            {
              "locale": "en",
              "text": "Model Loading"
            },
            {
              "locale": "de",
              "text": "Nachladen von Modellen"
            }
          ],
          "initialActivity": {
            "descriptor": {
              "section": "UIHandling",
              "feature": "CaseModelLoading"
            }
          }
        },
        "flows": [
          {
            "name": "ui_handling.case.model-loading",
            "scenes": [
              {
                "name": "CaseModelLoading",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "UIHandling"
                  },
                  {
                    "key": "feature",
                    "mustEqual": "CaseModelLoading"
                  }
                ],
                "defaultCase": "DefaultCaseModel",
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "GenericCaseMenu",
                      "region": [
                        "SIDEBAR"
                      ]
                    }
                  ]
                },
                "cases": [
                  {
                    "name": "DefaultCaseModel",
                    "label": [
                      {
                        "locale": "en",
                        "text": "default case model"
                      },
                      {
                        "locale": "de",
                        "text": "Standardcasemodell"
                      }
                    ],
                    "sceneChange": {
                      "onEnter": [
                        {
                          "type": "VIEW_ADD",
                          "name": "CaseModelLoading.ModelDefaultCase",
                          "models": [
                            {
                              "modelType": "document",
                              "name": "DefaultCaseExampleModel"
                            }
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "name": "Model",
                    "label": [
                      {
                        "locale": "en",
                        "text": "second case model"
                      },
                      {
                        "locale": "de",
                        "text": "Modell im zweiten Case"
                      }
                    ],
                    "sceneChange": {
                      "onEnter": [
                        {
                          "type": "VIEW_ADD",
                          "name": "CaseModelLoading.ModelSecondCase",
                          "models": [
                            {
                              "modelType": "document",
                              "name": "SecondCaseExampleModel"
                            }
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
