{
  "header": {
    "id": "notifications.appmodel",
    "modelType": "application",
    "modelVersion": "6.0.0",
    "locales": [
      {
        "code": "en"
      },
      {
        "code": "de"
      }
    ]
  },
  "content": {
    "region": {
      "name": "APP",
      "layout": {
        "name": "ApplicationFrame"
      },
      "subRegions": [
        {
          "name": "CONTENT",
          "layout": {
            "name": "MasterDetail"
          }
        }
      ]
    },
    "defaultRegion": [
      "CONTENT"
    ],
    "modules": [
      {
        "name": "ui_handling.notifications",
        "menu": {
          "name": "ui_handling.notifications",
          "label": [
            {
              "locale": "en",
              "text": "Notifications"
            },
            {
              "locale": "de",
              "text": "Benachrichtigungen"
            }
          ],
          "initialActivity": {
            "descriptor": {
              "section": "UIHandling",
              "feature": "Notifications",
              "model": "NotificationExample-document",
              "instance": "__NEW__"
            }
          }
        },
        "flows": [
          {
            "name": "ui_handling.notifications",
            "scenes": [
              {
                "name": "Notifications",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "UIHandling"
                  },
                  {
                    "key": "feature",
                    "mustEqual": "Notifications"
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "NotificationsForm",
                      "loadData": true
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
