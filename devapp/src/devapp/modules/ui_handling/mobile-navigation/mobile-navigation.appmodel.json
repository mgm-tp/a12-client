{
  "header": {
    "id": "mobile-navigation.appmodel",
    "modelType": "application",
    "modelVersion": "6.0.0",
    "locales": [
      {
        "code": "en"
      },
      {
        "code": "de"
      }
    ]
  },
  "content": {
    "region": {
      "name": "APP",
      "layout": {
        "name": "ApplicationFrame"
      },
      "subRegions": [
        {
          "name": "CONTENT",
          "layout": {
            "name": "MasterDetail"
          }
        },
        {
          "name": "SIDEBAR",
          "layout": {
            "name": "Null"
          }
        }
      ]
    },
    "defaultRegion": [
      "CONTENT"
    ],
    "modules": [
      {
        "name": "ui_handling.mobile-navigation",
        "menu": {
          "name": "ui_handling.mobile-navigation",
          "label": [
            {
              "locale": "en",
              "text": "Mobile Navigation"
            },
            {
              "locale": "de",
              "text": "Mobile Navigation"
            }
          ],
          "children": [
            {
              "name": "master-detail-layout",
              "label": [
                {
                  "locale": "en",
                  "text": "Master Detail Layout"
                },
                {
                  "locale": "de",
                  "text": "Master Detail Layout"
                }
              ],
              "initialActivity": {
                "descriptor": {
                  "section": "UIHandling",
                  "feature": "MobileNavigation.MasterDetailLayout",
                  "model": "Person-document"
                }
              }
            },
            {
              "name": "dashboard-layout",
              "label": [
                {
                  "locale": "en",
                  "text": "Dashboard Layout"
                },
                {
                  "locale": "de",
                  "text": "Dashboard Layout"
                }
              ],
              "initialActivity": {
                "descriptor": {
                  "section": "UIHandling",
                  "feature": "DashboardLayout",
                  "model": "Person-document"
                }
              }
            },
            {
              "name": "stack-layout",
              "label": [
                {
                  "locale": "en",
                  "text": "Stack Layout"
                },
                {
                  "locale": "de",
                  "text": "Stack Layout"
                }
              ],
              "initialActivity": {
                "descriptor": {
                  "section": "UIHandling",
                  "feature": "StackLayout"
                }
              }
            },
            {
              "name": "null-region-layout",
              "label": [
                {
                  "locale": "en",
                  "text": "Null Region Layout"
                },
                {
                  "locale": "de",
                  "text": "Null Region Layout"
                }
              ],
              "initialActivity": {
                "descriptor": {
                  "section": "UIHandling",
                  "feature": "NullRegionLayout"
                }
              }
            }
          ]
        },
        "flows": [
          {
            "name": "MasterDetail",
            "scenes": [
              {
                "name": "MasterDetailLayout",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "UIHandling"
                  },
                  {
                    "key": "feature",
                    "mustEqual": "MobileNavigation.MasterDetailLayout"
                  },
                  {
                    "key": "model",
                    "mustEqual": "Person-document"
                  },
                  {
                    "key": "instance",
                    "isSet": false
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "REGION_CLEAR",
                      "region": [
                        "SIDEBAR"
                      ]
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "MobileNavigationOverviewEngineSidebar",
                      "region": [
                        "SIDEBAR"
                      ]
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "PersonOverview",
                      "constraints": {
                        "type": "MasterDetail"
                      },
                      "models": [
                        {
                          "modelType": "document",
                          "name": "Person-document"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "name": "MobileNavigationForm",
                "matchConditions": [
                  {
                    "key": "feature",
                    "mustEqual": "MobileNavigation.MasterDetailLayout"
                  },
                  {
                    "key": "instance",
                    "isSet": true
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "PersonForm",
                      "models": [
                        {
                          "modelType": "document",
                          "name": "Person-document"
                        }
                      ]
                    },
                    {
                      "type": "REGION_CLEAR",
                      "layout": {
                        "name": "Null"
                      },
                      "region": [
                        "SIDEBAR"
                      ]
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "FormEngineSidebar",
                      "region": [
                        "SIDEBAR"
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "name": "DashboardLayout",
            "scenes": [
              {
                "name": "InitDashboardExample",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "UIHandling"
                  },
                  {
                    "key": "feature",
                    "mustEqual": "DashboardLayout"
                  },
                  {
                    "key": "scene",
                    "isSet": false
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "MobileNavDashboard"
                    }
                  ]
                }
              },
              {
                "name": "DashboardExample",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "UIHandling"
                  },
                  {
                    "key": "feature",
                    "mustEqual": "DashboardLayout"
                  },
                  {
                    "key": "scene",
                    "mustEqual": "Dashboard"
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "REGION_CLEAR",
                      "region": [
                        "SIDEBAR"
                      ],
                      "layout": {
                        "name": "Null"
                      }
                    },
                    {
                      "type": "REGION_CLEAR",
                      "layout": {
                        "name": "Dashboard",
                        "settings": {
                          "rows": [
                            {
                              "columns": [
                                {
                                  "width": {
                                    "sm": 9,
                                    "md": 8,
                                    "lg": 8
                                  }
                                },
                                {
                                  "width": {
                                    "sm": 3,
                                    "md": 4,
                                    "lg": 4
                                  }
                                }
                              ]
                            },
                            {
                              "columns": [
                                {
                                  "width": {
                                    "sm": 12,
                                    "md": 12,
                                    "lg": 12
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              },
              {
                "name": "Tile1",
                "description": "This scene adds the first tile",
                "priorScene": "DashboardExample",
                "matchConditions": [
                  {
                    "key": "tile",
                    "mustEqual": "Tile1"
                  },
                  {
                    "key": "instance",
                    "isSet": false
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "DashboardView",
                      "constraints": {
                        "title": "Tile 1"
                      }
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "MobileNavigationDashboardSidebar",
                      "region": [
                        "SIDEBAR"
                      ]
                    }
                  ]
                }
              },
              {
                "name": "Tile2",
                "description": "This scene adds the second tile",
                "priorScene": "DashboardExample",
                "matchConditions": [
                  {
                    "key": "tile",
                    "mustEqual": "Tile2"
                  },
                  {
                    "key": "instance",
                    "isSet": false
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "DashboardView",
                      "constraints": {
                        "title": "Tile 2"
                      }
                    }
                  ]
                }
              },
              {
                "name": "CRUDOverviewTitle",
                "description": "This scene adds the third tile",
                "priorScene": "DashboardExample",
                "matchConditions": [
                  {
                    "key": "model",
                    "mustEqual": "Person-document"
                  },
                  {
                    "key": "instance",
                    "isSet": false
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "PersonOverview",
                      "models": [
                        {
                          "modelType": "document",
                          "name": "Person-document"
                        }
                      ]
                    }
                  ],
                  "onExit": [
                    {
                      "type": "REGION_CLEAR",
                      "layout": {
                        "name": "MasterDetail"
                      }
                    }
                  ]
                }
              },
              {
                "name": "CrudDetail",
                "priorScene": "CRUDOverviewTitle",
                "matchConditions": [
                  {
                    "key": "instance",
                    "isSet": true
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "FormEngine",
                      "models": [
                        {
                          "modelType": "form",
                          "name": "MobileNavigation-form"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "name": "StackLayout",
            "scenes": [
              {
                "name": "StackLayout",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "UIHandling"
                  },
                  {
                    "key": "feature",
                    "mustEqual": "StackLayout"
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "REGION_CLEAR",
                      "layout": {
                        "name": "Stack"
                      }
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "StackLayoutView"
                    }
                  ]
                }
              }
            ]
          },
          {
            "name": "NullRegionLayout",
            "scenes": [
              {
                "name": "NullRegionLayout",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "UIHandling"
                  },
                  {
                    "key": "feature",
                    "mustEqual": "NullRegionLayout"
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "REGION_CLEAR",
                      "layout": {
                        "name": "Null"
                      }
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "NullRegionView",
                      "constraints": {
                        "title": "View 1"
                      }
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "NullRegionView",
                      "constraints": {
                        "title": "View 2"
                      }
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "NullRegionView",
                      "constraints": {
                        "title": "View 3"
                      }
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "NullRegionSidebar",
                      "region": [
                        "SIDEBAR"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
