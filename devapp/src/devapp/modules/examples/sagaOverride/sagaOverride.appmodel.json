{
  "header": {
    "id": "sagaOverride.appmodel",
    "modelType": "application",
    "modelVersion": "6.0.0",
    "locales": [
      {
        "code": "en"
      },
      {
        "code": "de"
      }
    ]
  },
  "content": {
    "region": {
      "name": "APP",
      "layout": {
        "name": "ApplicationFrame"
      },
      "subRegions": [
        {
          "name": "CONTENT",
          "layout": {
            "name": "MasterDetail"
          }
        }
      ]
    },
    "defaultRegion": [
      "CONTENT"
    ],
    "modules": [
      {
        "name": "examples.saga-override",
        "menu": {
          "name": "examples.saga-override",
          "label": [
            {
              "locale": "en",
              "text": "Saga Override"
            },
            {
              "locale": "de",
              "text": "Saga überschreiben"
            }
          ],
          "initialActivity": {
            "descriptor": {
              "section": "Examples",
              "example": "SagaOverride"
            }
          }
        },
        "flows": [
          {
            "name": "examples.saga-override",
            "scenes": [
              {
                "name": "SagaOverride",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "Examples"
                  },
                  {
                    "key": "example",
                    "mustEqual": "SagaOverride"
                  },
                  {
                    "key": "instance",
                    "isSet": false
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "SagaOverride",
                      "constraints": {
                        "type": "MasterDetail"
                      }
                    }
                  ]
                }
              },
              {
                "name": "SagaOverrideDetail",
                "description": "Nested Activity",
                "matchConditions": [
                  {
                    "key": "instance",
                    "isSet": true
                  }
                ],
                "priorScene": "SagaOverride",
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "CustomCommit"
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
