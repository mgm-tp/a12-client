{
  "header": {
    "id": "initialData.appmodel",
    "modelType": "application",
    "modelVersion": "6.0.0",
    "locales": [
      {
        "code": "en"
      },
      {
        "code": "de"
      }
    ]
  },
  "content": {
    "region": {
      "name": "APP",
      "layout": {
        "name": "ApplicationFrame"
      },
      "subRegions": [
        {
          "name": "CONTENT",
          "layout": {
            "name": "MasterDetail"
          }
        }
      ]
    },
    "defaultRegion": [
      "CONTENT"
    ],
    "modules": [
      {
        "name": "examples.initial-data",
        "menu": {
          "name": "examples.initial-data",
          "label": [
            {
              "locale": "en",
              "text": "Activity with initial data"
            },
            {
              "locale": "de",
              "text": "Activity mit initialen Daten"
            }
          ],
          "initialActivity": {
            "descriptor": {
              "section": "DataHandling",
              "feature": "InitialData",
              "model": "InitialData-document"
            }
          }
        },
        "flows": [
          {
            "name": "examples.initial-data",
            "scenes": [
              {
                "name": "InitialData",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "DataHandling"
                  },
                  {
                    "key": "feature",
                    "mustEqual": "InitialData"
                  },
                  {
                    "key": "instance",
                    "isSet": false
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "InitialDataFeature"
                    }
                  ]
                }
              },
              {
                "name": "InitialDataForm",
                "description": "The scene shows the form for an activity with initial data",
                "priorScene": "InitialData",
                "matchConditions": [
                  {
                    "key": "instance",
                    "isSet": true
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "REGION_CLEAR"
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "InitialDataForm",
                      "models": [
                        {
                          "modelType": "document",
                          "name": "InitialData-document"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
