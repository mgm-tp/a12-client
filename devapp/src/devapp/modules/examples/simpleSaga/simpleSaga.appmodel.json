{
  "header": {
    "id": "simpleSaga.appmodel",
    "modelType": "application",
    "modelVersion": "6.0.0",
    "locales": [
      {
        "code": "en"
      },
      {
        "code": "de"
      }
    ]
  },
  "content": {
    "region": {
      "name": "APP",
      "layout": {
        "name": "ApplicationFrame"
      },
      "subRegions": [
        {
          "name": "CONTENT",
          "layout": {
            "name": "MasterDetail"
          }
        },
        {
          "name": "SIDEBAR",
          "layout": {
            "name": "Null"
          }
        }
      ]
    },
    "defaultRegion": [
      "CONTENT"
    ],
    "modules": [
      {
        "name": "examples.background-saga",
        "menu": {
          "name": "examples.background-saga",
          "label": [
            {
              "locale": "en",
              "text": "Background Saga"
            },
            {
              "locale": "de",
              "text": "Hintergrund Saga"
            }
          ],
          "initialActivity": {
            "descriptor": {
              "section": "Examples",
              "example": "BackgroundSaga"
            }
          }
        },
        "flows": [
          {
            "name": "examples.background-saga",
            "scenes": [
              {
                "name": "BackgroundSaga",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "Examples"
                  },
                  {
                    "key": "example",
                    "mustEqual": "BackgroundSaga"
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "SimpleSaga"
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "SimpleSagaStatus",
                      "region": [
                        "SIDEBAR"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
