{
  "header": {
    "id": "focusHandlingProgressIndicator.appmodel",
    "modelType": "application",
    "modelVersion": "6.0.0",
    "locales": [
      {
        "code": "en"
      },
      {
        "code": "de"
      }
    ]
  },
  "content": {
    "region": {
      "name": "APP",
      "layout": {
        "name": "ApplicationFrame"
      },
      "subRegions": [
        {
          "name": "CONTENT",
          "layout": {
            "name": "MasterDetail"
          }
        }
      ]
    },
    "defaultRegion": [
      "CONTENT"
    ],
    "modules": [
      {
        "name": "examples.focus_handling_progress_indicator",
        "menu": {
          "name": "examples.focus_handling_progress_indicator",
          "label": [
            {
              "locale": "en",
              "text": "Progress Indicator Custom Focus Handling"
            },
            {
              "locale": "de",
              "text": "Progress Indicator Custom Focus Handling"
            }
          ],
          "initialActivity": {
            "descriptor": {
              "section": "Examples",
              "feature": "FocusHandlingProgressIndicator"
            }
          }
        },
        "flows": [
          {
            "name": "examples.focus_handling_progress_indicator",
            "scenes": [
              {
                "name": "FocusHandlingDescription",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "Examples"
                  },
                  {
                    "key": "feature",
                    "mustEqual": "FocusHandlingProgressIndicator"
                  },
                  {
                    "key": "instance",
                    "isSet": false
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "REGION_CLEAR"
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "DescriptionView",
                      "constraints": {
                        "type": "MasterDetail"
                      }
                    }
                  ]
                }
              },
              {
                "name": "FocusHandlingView1",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "Examples"
                  },
                  {
                    "key": "feature",
                    "mustEqual": "FocusHandlingProgressIndicator"
                  },
                  {
                    "key": "instance",
                    "mustEqual": "viewWithApplicationProgressIndicator"
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "ViewWithApplicationProgressIndicator",
                      "loadData": true
                    }
                  ]
                }
              },
              {
                "name": "FocusHandlingView2",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "Examples"
                  },
                  {
                    "key": "feature",
                    "mustEqual": "FocusHandlingProgressIndicator"
                  },
                  {
                    "key": "instance",
                    "mustEqual": "viewWithOwnProgressIndicator"
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "ViewWithOwnProgressIndicator",
                      "loadData": true
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
