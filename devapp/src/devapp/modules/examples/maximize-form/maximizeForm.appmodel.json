{
  "header": {
    "id": "maximizeForm.appmodel",
    "modelType": "application",
    "modelVersion": "6.0.0",
    "locales": [
      {
        "code": "en"
      },
      {
        "code": "de"
      }
    ]
  },
  "content": {
    "region": {
      "name": "APP",
      "layout": {
        "name": "ApplicationFrame"
      },
      "subRegions": [
        {
          "name": "CONTENT",
          "layout": {
            "name": "MasterDetail"
          }
        }
      ]
    },
    "defaultRegion": [
      "CONTENT"
    ],
    "modules": [
      {
        "name": "examples.maximize-form",
        "menu": {
          "name": "examples.maximize-form",
          "label": [
            {
              "locale": "en",
              "text": "Maximize Form View"
            },
            {
              "locale": "de",
              "text": "Form View Maximieren"
            }
          ],
          "initialActivity": {
            "descriptor": {
              "section": "Examples",
              "example": "MaximizeForm"
            }
          }
        },
        "flows": [
          {
            "name": "examples.maximize-form",
            "scenes": [
              {
                "name": "MaximizeFormExampleIntro",
                "description": "Explanation of the Maximize Form Example",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "Examples"
                  },
                  {
                    "key": "example",
                    "mustEqual": "MaximizeForm"
                  },
                  {
                    "key": "instance",
                    "isSet": false
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "REGION_CLEAR"
                    },
                    {
                      "type": "VIEW_ADD",
                      "name": "MaximizeOverview",
                      "constraints": {
                        "type": "MasterDetail"
                      }
                    }
                  ]
                }
              },
              {
                "name": "MaximizeFormExample",
                "description": "MaximizeFormExample",
                "matchConditions": [
                  {
                    "key": "section",
                    "mustEqual": "Examples"
                  },
                  {
                    "key": "example",
                    "mustEqual": "MaximizeForm"
                  },
                  {
                    "key": "instance",
                    "isSet": true
                  }
                ],
                "sceneChange": {
                  "onEnter": [
                    {
                      "type": "VIEW_ADD",
                      "name": "MaximizeFormView",
                      "models": [
                        {
                          "modelType": "document",
                          "name": "Person-document"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
