{
  "name": "@com.mgmtp.a12.client/client-devapp",
  "version": "17.0.1",
  "description": "Client Devapp",
  "author": "mgm technology partners",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/devapp/whyDidYouRender/index.ts"
  ],
  "scripts": {
    "clean": "rimraf ./lib ./dist ./target",
    "build": "node --run compile && node --run assemble",
    "compile": "tsc",
    "test": "mocha",
    "assemble": "rsbuild build -c rsbuild/rsbuild.config.ts",
    "start": "rsbuild dev --env-mode mock -c rsbuild/rsbuild.config.ts",
    "start:platform": "concurrently --kill-others pnpm:start:platform:app pnpm:start:platform:server",
    "start:platform:app": "rsbuild dev --env-mode platform -c rsbuild/rsbuild.config.ts",
    "start:platform:server": "gradle -p ./resources/server --console=plain runJar",
    "watch": "tsc --watch",
    "mocha:dev": "mocha --forbid-only=false",
    "analyze": "rsbuild build --env-mode analyze -c rsbuild/rsbuild.config.ts",
    "preview": "rsbuild preview -c rsbuild/rsbuild.config.ts",
    "lint": "eslint --flag unstable_native_nodejs_ts_config . --cache",
    "lint:fix": "node --run lint -- --fix",
    "lint:onlyErrors": "node --run lint -- --quiet"
  },
  "dependencies": {
    "@com.mgmtp.a12.base/base-model-api": "catalog:a12",
    "@com.mgmtp.a12.client/client-core": "workspace:*",
    "@com.mgmtp.a12.client/client-data": "workspace:*",
    "@com.mgmtp.a12.client/typescript-fsa-redux-5-compat": "catalog:a12",
    "@com.mgmtp.a12.dataservices/dataservices-access": "catalog:a12",
    "@com.mgmtp.a12.devtools/why-did-you-render": "catalog:a12",
    "@com.mgmtp.a12.kernel/kernel-core-runtime-api-ts": "catalog:a12",
    "@com.mgmtp.a12.kernel/kernel-md-facade": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-collections": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-connector": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-localization": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-localization-react": "catalog:a12",
    "@com.mgmtp.a12.utils/utils-logging": "catalog:a12",
    "@com.mgmtp.a12.widgets/widgets-core": "catalog:a12",
    "@redux-devtools/extension": "catalog:",
    "fast-deep-equal": "catalog:",
    "fp-ts": "catalog:",
    "monocle-ts": "catalog:",
    "react": "catalog:",
    "react-dnd": "catalog:",
    "react-dom": "catalog:",
    "react-redux": "catalog:",
    "redux": "catalog:",
    "redux-saga": "catalog:",
    "styled-components": "catalog:",
    "typed-redux-saga": "catalog:"
  },
  "devDependencies": {
    "@com.mgmtp.a12.devtools/tsconfig": "catalog:a12",
    "@jambit/eslint-plugin-typed-redux-saga": "catalog:",
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-react": "catalog:",
    "@rsdoctor/rspack-plugin": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/semver": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "mocha": "catalog:",
    "picocolors": "catalog:",
    "rimraf": "catalog:",
    "semver": "catalog:",
    "source-map-loader": "catalog:",
    "source-map-support": "catalog:",
    "typescript": "catalog:"
  },
  "browserslist": [
    "last 1 chrome version",
    "last 1 firefox version",
    "last 1 safari version"
  ],
  "exports": null
}
